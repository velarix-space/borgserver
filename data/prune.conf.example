# Borg Prune Configuration
# 
# This file allows you to configure automatic pruning rules for each client.
# Pruning removes old backup archives according to retention policies.
#
# Format:
# [client_name]
# keep_daily = 7
# keep_weekly = 4
# keep_monthly = 6
# keep_yearly = 1
# keep_within = 14d
# enabled = yes
#
# Options:
# - keep_daily: Number of daily backups to keep
# - keep_weekly: Number of weekly backups to keep
# - keep_monthly: Number of monthly backups to keep
# - keep_yearly: Number of yearly backups to keep
# - keep_within: Keep all archives within this time period (e.g., "14d", "2m", "1y")
# - enabled: Set to "no" to disable pruning for this client
#
# The [default] section applies to all clients that don't have specific configuration.
# Client-specific sections override the default settings.
#
# Example:

[default]
keep_daily = 7
keep_weekly = 4
keep_monthly = 6
keep_yearly = 1
enabled = yes

# Example client-specific configuration:
# [webserver]
# keep_daily = 14
# keep_weekly = 8
# keep_monthly = 12
# keep_yearly = 2
# enabled = yes
#
# [development-machine]
# keep_daily = 3
# keep_weekly = 2
# keep_monthly = 0
# keep_yearly = 0
# enabled = yes
#
# [archive-server]
# keep_within = 30d
# keep_monthly = 24
# keep_yearly = 5
# enabled = yes
